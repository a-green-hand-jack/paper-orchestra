{
  "name": "paper-orchestra",
  "version": "2.0.0",
  "description": "OpenCode-native agent that turns raw research materials into submission-ready LaTeX manuscripts",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "paper-orchestra": "./dist/cli.js"
  },
  "files": [
    "dist",
    "assets",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:official-templates": "npm run build && node scripts/verify-official-templates.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@opencode-ai/sdk": "^1.18.25",
    "commander": "^12.1.0",
    "execa": "^9.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
