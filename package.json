{
  "name": "paper-orchestra",
  "version": "2.0.0",
  "description": "OpenCode-native agent that turns raw research materials into submission-ready LaTeX manuscripts",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "paper-orchestra": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "npm run build && node --test tests/*.test.mjs",
    "build": "tsc -p tsconfig.json && node scripts/copy-runtime-assets.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opencode-ai/sdk": "^1.18.25",
    "commander": "^12.1.0",
    "execa": "^9.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
